# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key (console.anthropic.com) - server-side only, powers the AI
# features (Claude Opus 5). Never exposed to the browser.
ANTHROPIC_API_KEY=
